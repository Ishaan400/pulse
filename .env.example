# Copy to .env and fill in. Never commit .env.

# --- Django ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Your domain or server IP, comma-separated
DJANGO_ALLOWED_HOSTS=pulse.example.com,localhost
# Full origins (scheme + host) the browser loads Pulse from
DJANGO_CSRF_TRUSTED_ORIGINS=https://pulse.example.com
# Set both to 1 once Pulse is served over HTTPS (behind Caddy/nginx/a load balancer)
DJANGO_SECURE_COOKIES=0
DJANGO_BEHIND_TLS_PROXY=0
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database / broker (used by docker-compose) ---
POSTGRES_USER=pulse
POSTGRES_DB=pulse
POSTGRES_PASSWORD=
RABBITMQ_USER=pulse
RABBITMQ_PASSWORD=

# --- First admin, created on boot if missing ---
PULSE_ADMIN_USERNAME=admin
PULSE_ADMIN_EMAIL=
PULSE_ADMIN_PASSWORD=

# --- SLA checker interval (seconds) ---
PULSE_SLA_CHECK_SECONDS=60

# --- AI analysis: leave blank until you have a key; the endpoint returns 503 until then ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ports ---
PULSE_PORT=8000
GUNICORN_WORKERS=3
